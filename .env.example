# Copy to .env.local for local development. Never commit real values.
# In production (VERCEL_ENV=production) the app refuses to start if a required
# variable is missing.

# --- Neon Postgres (required in production; set by the Vercel Marketplace integration) ---
# Local dev: a local Postgres, e.g. postgres://postgres@127.0.0.1:5432/finance (see README)
DATABASE_URL=
# Direct connection, used for migrations if present (also set by the integration)
# DATABASE_URL_UNPOOLED=

# --- Better Auth (required in production) ---
# Random secret, at least 32 chars: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Public origin of the app, e.g. https://finance.example.com (local: http://localhost:3000)
BETTER_AUTH_URL=

# --- Envelope encryption (required in production) ---
# Base64 of 32 random bytes: `openssl rand -base64 32`. Losing it makes encrypted data unreadable.
MASTER_KEY=
# Bump when rotating; keep the old key in MASTER_KEY_PREVIOUS until users are re-wrapped.
MASTER_KEY_ID=1
# MASTER_KEY_PREVIOUS=

# --- Sign-in email (required in production) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Dev / e2e only (rejected in production) ---
# 1 = keep one-time codes in memory and expose them at /api/dev/outbox
DEV_MAIL_OUTBOX=0

# --- Public site config ---
# Where the "Built by toninmotion" footer credit links to (optional).
NEXT_PUBLIC_PORTFOLIO_URL=
